{
  "name": "signal-passport",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "tsx --test",
    "dev:passport": "npm run dev --prefix apps/passport",
    "dev:consumer": "npm run dev --prefix apps/consumer",
    "dev": "concurrently -n GENERATOR,VERIFIER -c blue,magenta \"npm:dev:passport\" \"npm:dev:consumer\"",
    "build:passport": "npm run build --prefix apps/passport",
    "build:consumer": "npm run build --prefix apps/consumer"
  },
  "devDependencies": {
    "@types/node": "^24.13.4",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "concurrently": "^10.0.5",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "js-sha3": "^0.13.0",
    "next": "^15.5.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^4.6.2"
  }
}
