{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": [
      "node"
    ],
    "paths": {
      "@signal-passport/schema": [
        "./packages/schema/src/index.ts"
      ],
      "@signal-passport/schema/*": [
        "./packages/schema/src/*"
      ],
      "@signal-passport/analysis": [
        "./packages/analysis/src/index.ts"
      ],
      "@signal-passport/analysis/*": [
        "./packages/analysis/src/*"
      ]
    }
  },
  "include": [
    "packages/**/*",
    "tests/**/*"
  ]
}
